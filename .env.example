# --- Core ---
NODE_ENV=development
APP_URL=http://localhost:4000
WEB_URL=http://localhost:5173
API_PORT=4000
WEB_PORT=5173

# --- Database / Queue ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/returnsense
REDIS_URL=redis://localhost:6379

# --- Auth / crypto ---
JWT_SECRET=change-me-long-random
COOKIE_SECRET=change-me-long-random
# 32-byte base64 key: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=change-me-32-byte-base64-key

# --- Shopify ---
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SCOPES=read_orders,read_returns,read_customers,read_fulfillments
SHOPIFY_API_VERSION=2025-07

# --- Klaviyo ---
KLAVIYO_CLIENT_ID=
KLAVIYO_CLIENT_SECRET=
KLAVIYO_SCOPES=profiles:read profiles:write events:write metrics:read
KLAVIYO_API_REVISION=2025-07-15

# --- Notifications (optional) ---
NOTIFY_EMAIL_FROM=
NOTIFY_EMAIL_TO=
SLACK_WEBHOOK_URL=

# --- Frontend (Vite) ---
VITE_API_URL=http://localhost:4000/api
